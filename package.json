{
  "name": "actions-quota-bot",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Actions 사용량과 레포별 예산을 디스코드로 알려 주는 봇 (Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-env=false",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply actions-quota-bot --local",
    "db:migrate": "wrangler d1 migrations apply actions-quota-bot --remote",
    "register": "node --env-file=.dev.vars scripts/register-commands.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.159.0"
  }
}
