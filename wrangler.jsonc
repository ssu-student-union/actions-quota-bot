{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "actions-quota-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // 매시 정각에 사용량 수집 + 알림 확인 (GitHub 데이터 자체가 몇 시간 늦게 반영됨)
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "actions-quota-bot",
      // `wrangler d1 create actions-quota-bot` 후 나온 ID로 교체
      "database_id": "32b517aa-9f38-4808-b420-806ae969655b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_ORG": "ssu-student-union",
    // 이 Worker의 공개 URL (진행 막대 이미지 주소)
    "PUBLIC_URL": "https://actions-quota-bot.ssu-it-support.workers.dev",
    // 플랜에 포함된 월 무료 분 (Free 플랜 2,000분)
    "FREE_MINUTES": "2000",
    // 알림 기준(%)
    "ALERT_THRESHOLDS": "50,80,100",
    // 알림을 보낼 디스코드 채널 ID (비우면 로그만 남기고 보내지 않음)
    "ALERT_CHANNEL_ID": "1333427853777440820",
    // 중요한 알림(무료 분 소진, Actions 정지, 예산 없이 과금) 때 멘션할 역할 ID (선택)
    "ALERT_MENTION_ROLE_ID": "",
    // 중요한 알림 때 레포 이름으로 frontend / backend를 골라 태그할 역할 ID (src/roles.ts)
    // 조직 전체 알림(무료 분 소진)이나 파트를 모르는 레포는 둘 다 태그
    "FRONTEND_ROLE_ID": "",
    "BACKEND_ROLE_ID": "",
    // /team 명령을 쓸 수 있는 역할 ID (비우면 '서버 관리' 권한자만)
    "ADMIN_ROLE_ID": "",
    // 수집 실패(토큰 만료 등) 알림 때 멘션할 사용자 ID (봇 관리자)
    "FAILURE_MENTION_USER_ID": "660302890899996675"
  }
  // secrets: GITHUB_TOKEN, DISCORD_PUBLIC_KEY, DISCORD_APP_ID, DISCORD_BOT_TOKEN
}
